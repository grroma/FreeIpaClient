<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>10.0.0</Version>
        <Authors>grroma01</Authors>
        <Description>Client for working with API FreeIpa in C#</Description>
        <PackageProjectUrl>https://github.com/grroma/FreeIpaClient</PackageProjectUrl>
        <license>https://github.com/grroma/FreeIpaClient/blob/master/LICENSE</license>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/grroma/FreeIpaClient</RepositoryUrl>
        <PackageTags>.net freeipa api c#</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../icon.png" Pack="true" PackagePath=""/>
        <None Include="../../README.md" Pack="true" PackagePath=""/>
        <None Include="../../LICENSE.txt" Pack="true" PackagePath=""/>
    </ItemGroup>

</Project>
