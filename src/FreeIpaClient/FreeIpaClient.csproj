<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>FreeIpaClient</PackageId>
        <Title>FreeIpaClient</Title>
        <Version>10.0.0</Version>
        <Authors>grroma01</Authors>
        <Description>Client for working with the FreeIPA API in C#.</Description>
        <PackageProjectUrl>https://github.com/grroma/FreeIpaClient</PackageProjectUrl>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/grroma/FreeIpaClient</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>dotnet freeipa ipa api csharp</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageReleaseNotes>Targets .NET 10, uses System.Text.Json, supports response envelopes, API version detection, generic API calls, and repository tooling for metadata-based code generation.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../icon.png" Pack="true" PackagePath=""/>
        <None Include="../../README.md" Pack="true" PackagePath=""/>
        <None Include="../../LICENSE.txt" Pack="true" PackagePath=""/>
    </ItemGroup>

</Project>
